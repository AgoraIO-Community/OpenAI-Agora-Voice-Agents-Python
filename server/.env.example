AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
PORT=8000

# Required for OpenAI GPT Live
OPENAI_API_KEY=

# Optional opening line override
# AGENT_GREETING=Hi there! I'm Ada, your virtual assistant from Agora. How can I help?

# Optional persistent behavior guidance for GPT Live
# AGENT_INSTRUCTIONS=You are a helpful voice assistant. Keep responses concise and conversational.

# Optional prior user/assistant turns, separate from AGENT_INSTRUCTIONS
# AGENT_PRIOR_MESSAGES=[{"role":"user","content":"My name is Arlene."},{"role":"assistant","content":"Nice to meet you."}]
